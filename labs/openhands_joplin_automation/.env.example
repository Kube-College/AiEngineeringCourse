# Controller settings (see config.py). Live triage needs GH_REPO, GH_TOKEN and LLM_API_KEY.
AGENT_BACKEND=simulated
STATE_DIR=.data
WORKSPACE_DIR=.workspaces
POLL_SECONDS=20
GATEWAY_PORT=18301
RUN_TIMEOUT_SECONDS=1200
MAX_ITERATIONS=50
ISSUE_BUDGET_USD=5
GITHUB_WRITES_ENABLED=false
GH_REPO=
GH_TOKEN=
LLM_MODEL=openai/gpt-5.6-terra
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
